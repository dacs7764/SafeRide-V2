# Copy this file to .env.local for local testing with `vercel dev`.
# Never commit your real keys. On Vercel, set these under
# Project → Settings → Environment Variables instead.

# From https://dashboard.stripe.com/test/apikeys (starts with sk_test_ while testing)
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: your site's public address, e.g. https://saferide.vercel.app
# SITE_URL=
