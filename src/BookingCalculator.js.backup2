import React, { useState, useEffect } from 'react';
import LocationSearch from './LocationSearch';
import { calculateDistance, isValidLocation } from './mapsUtils';

// --- Square Payment Integration Component ---
// This simulates the Square payment form being dynamically loaded and rendered.
const SquarePaymentForm = ({ price }) => {
    // NOTE: These are MOCK IDs. Your company must replace these with their actual Sandbox or Production IDs.
    const SQUARE_APP_ID = 'sq0idp-MOCK-APP-ID-12345';
    const SQUARE_LOCATION_ID = 'MOCK_LOCATION_ID_54321';

    useEffect(() => {
        const initializeSquare = () => {
            if (!window.SqPaymentForm) {
                console.error("Square SDK not loaded. Check index.html script tag.");
                return;
            }

            const fieldStyle = {
                input: {
                    fontSize: '14px',
                    padding: '8px 12px',
                    color: '#333',
                },
            };

            // eslint-disable-next-line no-unused-vars
            const paymentForm = new window.SqPaymentForm({
                applicationId: SQUARE_APP_ID,
                locationId: SQUARE_LOCATION_ID,
                
                // Define the IDs of the HTML elements where the secure fields will be injected
                cardNumber: { elementId: 'sq-card-number', style: fieldStyle },
                cvv: { elementId: 'sq-cvv', style: fieldStyle },
                expirationDate: { elementId: 'sq-expiration-date', style: fieldStyle },
                postalCode: { elementId: 'sq-postal-code', style: fieldStyle },
                
                callbacks: {
                    /*
                    NOTE: In a real app, this is where you would handle the tokenization (payment submission).
                    */
                    cardNonceResponseReceived: function(errors, nonce, cardData) {
                        if (errors) {
                            console.error("Payment tokenization failed:", errors);
                            alert(`Error processing card: ${errors[0].message}`);
                            return;
                        }
                        console.log("SUCCESS! Payment Nonce generated (Ready for backend processing):", nonce);
                        alert(`Booking Confirmed! (Mock Payment Nonce: ${nonce})`);
                    },
                    unsupportedBrowserDetected: function() {
                        console.error("Browser unsupported by Square SDK.");
                    },
                    paymentFormLoaded: function() {
                        console.log("Square Payment Form fields loaded successfully.");
                    }
                }
            });

            return () => {};
        };
        
        if (window.SqPaymentForm) {
            initializeSquare();
        } else {
            const checkScript = setInterval(() => {
                if (window.SqPaymentForm) {
                    clearInterval(checkScript);
                    initializeSquare();
                }
            }, 100);
        }
    }, [price]);

    return (
        <div className="square-placeholder">
            <p style={{fontSize: '0.85rem', color: '#2F3691', fontWeight: 'bold', marginBottom: '10px'}}>
                (Secure Payment Fields are loading from Square's Servers)
            </p>
            <div className="square-form-mock">
                
                {/* These are the containers where Square will inject its secure iframes */}
                <div id="sq-card-number"></div>
                <div id="sq-expiration-date"></div>
                <div id="sq-cvv"></div>
                <div id="sq-postal-code"></div>

                <button 
                    className="square-pay-btn"
                    onClick={() => console.log("Simulating Square payment initiation...")}
                >
                    Complete Booking: Pay ${price}
                </button>
            </div>
        </div>
    );
};
// End of SquarePaymentForm component

// --- Mock Availability Logic ---
const getMockAvailableDates = () => {
    const dates = [];
    const today = new Date();
    for (let i = 0; i < 5; i++) {
        const nextDay = new Date(today);
        nextDay.setDate(today.getDate() + i + 1);
        dates.push(nextDay.toISOString().split('T')[0]);
    }
    return dates;
};

function BookingCalculator({ onNavigate }) {
  const availableDates = getMockAvailableDates();
  const [step, setStep] = useState(1); 
  const [formData, setFormData] = useState({
    pickup: '',
    dropoff: '',
    pickupLocation: null,
    dropoffLocation: null,
    date: availableDates[0],
    time: '12:00',
    riders: 1,
  });
  const [quote, setQuote] = useState(null);
  const [error, setError] = useState('');
  const [isCalculating, setIsCalculating] = useState(false);
  const [paymentMethod, setPaymentMethod] = useState(null);

  const handleLocationSelect = (type, locationData) => {
    setFormData(prev => ({
      ...prev,
      [type]: locationData.address,
      [`${type}Location`]: locationData
    }));
    setQuote(null);
    setError('');
  };

  const handleInputChange = (e) => {
    const { name, value } = e.target;
    setFormData(prev => ({ ...prev, [name]: value }));
    setQuote(null);
    setError('');
  };

  const calculateQuote = async () => {
    const { pickupLocation, dropoffLocation, riders } = formData;
    
    if (!isValidLocation(pickupLocation) || !isValidLocation(dropoffLocation) || !riders || !formData.date || !formData.time) {
      setError("Please select valid pickup and dropoff locations from the dropdown suggestions.");
      setQuote(null);
      return;
    }

    setIsCalculating(true);
    setError('');

    try {
      const distanceData = await calculateDistance(pickupLocation, dropoffLocation);
      const distance = distanceData.distance;
      const duration = distanceData.duration;
      
      let estimatedPrice = 0;
      let pricingDetails = "";
      
      // Check for fixed routes (Ithaca region)
      const isIthacaRegion = pickupLocation.address.toLowerCase().includes("ithaca") || 
                            pickupLocation.address.toLowerCase().includes("cornell") ||
                            dropoffLocation.address.toLowerCase().includes("ithaca") ||
                            dropoffLocation.address.toLowerCase().includes("cornell");
      
      // 1. Rochester route
      if (isIthacaRegion && (pickupLocation.address.toLowerCase().includes("rochester") || 
          dropoffLocation.address.toLowerCase().includes("rochester"))) {
        estimatedPrice = 100;
        pricingDetails = "Fixed rate: $100 one-way (Ithaca Region ↔ Rochester Region).";
      }
      // 2. Syracuse route
      else if (isIthacaRegion && (pickupLocation.address.toLowerCase().includes("syracuse") || 
          dropoffLocation.address.toLowerCase().includes("syracuse"))) {
        if (riders === 1) {
          estimatedPrice = 120;
          pricingDetails = "Fixed rate: $120 for single rider (Ithaca Region ↔ Syracuse Region).";
        } else {
          estimatedPrice = 90;
          pricingDetails = "Fixed rate: $90 total for multiple riders (shared ride discount applied).";
        }
      }
      // 3. Long distance routes
      else {
        estimatedPrice = distance * 1.00; // $1 per mile one-way
        
        if (estimatedPrice < 75) {
          estimatedPrice = 75;
          pricingDetails = `Minimum custom trip fee applied. Calculated at $1/mile one-way (${distance.toFixed(1)} miles).`;
        } else {
          pricingDetails = `$${1.00}/mile one-way (${distance.toFixed(1)} miles).`;
        }
      }
      
      setQuote({
        price: Math.round(estimatedPrice),
        distance: distance,
        duration: duration,
        details: pricingDetails,
        route: `${pickupLocation.address} to ${dropoffLocation.address}`
      });
    } catch (error) {
      setError("Unable to calculate distance. Please try different locations or check your internet connection.");
      setQuote(null);
    } finally {
      setIsCalculating(false);
    }
  };

  const handleBook = () => {
    setStep(2); // Proceed to Schedule
  };

  const handleSchedule = () => {
      setStep(3); // Proceed to Payment Method Selection
  };

  const handlePaymentMethodSelection = (method) => {
      setPaymentMethod(method);
      setStep(4); // Proceed to Payment Processing/Confirmation
  };

  // UI for the Quote Calculator (Step 1)
  const renderQuoteCalculator = () => (
    <div className="booking-container">
      <div className="calculator-panel">
        <h2 className="panel-title">1. Get Your Ride Quote</h2>

        <div className="form-group">
            <label htmlFor="pickup">Pick Up Location</label>
            <LocationSearch
                placeholder="City, Campus Name, or Full Address (e.g., Cornell University, Ithaca, NY)"
                value={formData.pickup}
                onChange={(value) => setFormData(prev => ({ ...prev, pickup: value }))}
                onSelect={(locationData) => handleLocationSelect('pickup', locationData)}
            />
        </div>
        
        <div className="form-group">
            <label htmlFor="dropoff">Drop Off Location</label>
            <LocationSearch
                placeholder="City, Airport Code (e.g., Syracuse Airport (SYR), Rochester, JFK)"
                value={formData.dropoff}
                onChange={(value) => setFormData(prev => ({ ...prev, dropoff: value }))}
                onSelect={(locationData) => handleLocationSelect('dropoff', locationData)}
            />
        </div>

        <div className="form-row">
            <div className="form-group half-width">
                <label htmlFor="date">Date (Availability Check)</label>
                <select 
                    id="date" name="date" value={formData.date} onChange={handleInputChange} required
                >
                    {availableDates.map(dateStr => (
                        <option key={dateStr} value={dateStr}>{new Date(dateStr).toLocaleDateString()}</option>
                    ))}
                </select>
            </div>

            <div className="form-group half-width">
                <label htmlFor="time">Time</label>
                <input 
                    id="time" name="time" type="time" value={formData.time} onChange={handleInputChange} required
                />
            </div>
        </div>

        <div className="form-group">
            <label htmlFor="riders">Number of Riders</label>
            <select id="riders" name="riders" value={formData.riders} onChange={handleInputChange}>
                {[1, 2, 3, 4, 5, 6].map(num => (
                    <option key={num} value={num}>{num} Rider{num > 1 ? 's' : ''}</option>
                ))}
            </select>
        </div>

        {error && <p className="error-message">{error}</p>}
        
        <button className="quote-btn large" onClick={calculateQuote} disabled={isCalculating}>
            {isCalculating ? 'CALCULATING...' : 'CALCULATE ESTIMATE'}
        </button>
      </div>

      <div className="quote-results-panel">
        <h2 className="panel-title">Route Preview & Estimate</h2>
        
        {quote ? (
          <div className="quote-display">
            <p className="quote-price-label">Estimated Price</p>
            <p className="quote-price">${quote.price}<span className="currency"> USD</span></p>
            
            <div className="quote-details">
                <p><strong>Route:</strong> {quote.route || `${formData.pickup} to ${formData.dropoff}`}</p>
                <p><strong>Distance (One-Way):</strong> {quote.distance} miles</p>
                <p><strong>Estimated Duration:</strong> {quote.duration || 'N/A'}</p>
                <p><strong>Riders:</strong> {formData.riders}</p>
                <p><strong>Pricing:</strong> {quote.details}</p>
            </div>
            
            <button className="book-btn" onClick={handleBook}>PROCEED TO SCHEDULE</button>
          </div>
        ) : (
          <div className="map-placeholder-box">
            <img src="/map-placeholder.png" alt="Map Preview" className="map-preview-image" />
            <p className="preview-message">Enter your trip details above to calculate distance and receive an instant quote.</p>
          </div>
        )}
      </div>
    </div>
  );

  // UI for the Scheduling Step (Step 2)
  const renderScheduleRide = () => (
    <div className="schedule-payment-container">
        <h2 className="panel-title">2. Schedule Your Ride</h2>
        <div className="back-link" onClick={() => setStep(1)}>&larr; Back to Quote</div>
        
        <div className="schedule-details">
            <div className="detail-card">
                <h3>Trip Summary</h3>
                <p><strong>From:</strong> {formData.pickup}</p>
                <p><strong>To:</strong> {formData.dropoff}</p>
                <p><strong>Date/Time:</strong> {new Date(formData.date).toLocaleDateString()} at {formData.time}</p>
                <p><strong>Riders:</strong> {formData.riders}</p>
                <p className="final-price"><strong>Total Cost:</strong> ${quote.price} USD</p>
            </div>
            
            <div className="payment-placeholder-card">
                <h3>Select Final Time & Driver (via Calendly)</h3>
                <p className="subtext">
                    Click the button below to open the external scheduling link in a new window to select your driver and final reservation time.
                </p>
                
                <a 
                    href="https://calendly.com/YOUR_COMPANY_LINK/safetrip-booking" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    className="calendly-link-btn"
                >
                    Open Calendly Scheduling Page
                </a>
                
                <p className="subtext" style={{marginTop: '2rem'}}>
                    Once scheduled on Calendly, confirm below to proceed to payment.
                </p>
                <button className="book-btn" onClick={handleSchedule}>I HAVE SCHEDULED, PROCEED TO PAYMENT</button>
            </div>
        </div>
    </div>
  );

  // UI for the Payment Step (Step 3) - Payment Method Selection
  const renderPaymentMethodSelection = () => (
    <div className="schedule-payment-container">
        <h2 className="panel-title">3. Select Payment Method</h2>
        <div className="back-link" onClick={() => setStep(2)}>&larr; Back to Scheduling</div>
        
        <div className="schedule-details">
            <div className="detail-card">
                <h3>Trip Summary</h3>
                <p><strong>From:</strong> {formData.pickup}</p>
                <p><strong>To:</strong> {formData.dropoff}</p>
                <p><strong>Date/Time:</strong> {new Date(formData.date).toLocaleDateString()} at {formData.time}</p>
                <p><strong>Riders:</strong> {formData.riders}</p>
                <p className="final-price"><strong>Total Cost:</strong> ${quote.price} USD</p>
            </div>
            
            <div className="payment-method-selection-card">
                <h3>How Would You Like to Pay?</h3>
                <p className="subtext">
                    Choose your preferred payment method to secure your booking.
                </p>
                
                <div className="payment-method-options">
                    <button 
                        className="payment-option-btn" 
                        onClick={() => handlePaymentMethodSelection('pay-person')}
                    >
                        <div className="payment-option-icon">💵</div>
                        <div className="payment-option-text">
                            <strong>Pay in Person</strong>
                            <p>Pay the driver when they arrive</p>
                        </div>
                    </button>
                    
                    <button 
                        className="payment-option-btn" 
                        onClick={() => handlePaymentMethodSelection('pay-card')}
                    >
                        <div className="payment-option-icon">💳</div>
                        <div className="payment-option-text">
                            <strong>Pay by Card</strong>
                            <p>Secure payment by card to confirm booking</p>
                        </div>
                    </button>
                </div>
                    </button>
                    
                    <button 
                        className="payment-option-btn" 
                        onClick={() => handlePaymentMethodSelection('pay-card')}
                    >
                        <div className="payment-option-icon">💳</div>
                        <div className="payment-option-text">
                            <strong>Pay by Card</strong>
                            <p>Secure payment by card to confirm booking</p>
                        </div>
                    </button>
                </div>
                        <div className="payment-option-text">
                            <strong>Pay with Card Now</strong>
                            <p>Secure payment by card to confirm booking</p>
                        </div>
                    </button>
                    
                    <button 
                        className="payment-option-btn" 
                        onClick={() => handlePaymentMethodSelection('cash-person')}
                    >
                        <div className="payment-option-icon">💵</div>
                        <div className="payment-option-text">
                            <strong>Pay with Cash in Person</strong>
                            <p>Pay the driver when they arrive</p>
                        </div>
                    </button>
                    
                    <button 
                        className="payment-option-btn" 
                        onClick={() => handlePaymentMethodSelection('card-person')}
                    >
                        <div className="payment-option-icon">💳</div>
                        <div className="payment-option-text">
                            <strong>Pay with Card in Person</strong>
                            <p>Pay the driver when they arrive</p>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
  );

  // UI for Step 4 - Payment Processing or Confirmation
  const renderPaymentProcessing = () => (
    <div className="schedule-payment-container">
        <h2 className="panel-title">4. Complete Your Booking</h2>
        <div className="back-link" onClick={() => setStep(3)}>&larr; Back to Payment Method</div>
        
        <div className="schedule-details">
            <div className="detail-card">
                <h3>Trip Summary</h3>
                <p><strong>From:</strong> {formData.pickup}</p>
                <p><strong>To:</strong> {formData.dropoff}</p>
                <p><strong>Date/Time:</strong> {new Date(formData.date).toLocaleDateString()} at {formData.time}</p>
                <p><strong>Riders:</strong> {formData.riders}</p>
                <p className="final-price"><strong>Total Cost:</strong> ${quote.price} USD</p>
            </div>
            
            <div className="payment-placeholder-card">
                <h3>Payment & Confirmation</h3>
                <p className="subtext">
                    {paymentMethod === 'pay-card' ? "Please use the secure form below to complete your payment and confirm your booking." : 
                     paymentMethod === 'pay-person' ? "Your booking will be confirmed. You'll pay the driver when they arrive." :
                     "Your booking will be confirmed. You'll pay the driver when they arrive with a card."}
                </p>
                
                {paymentMethod === 'card-now' && <SquarePaymentForm price={quote.price} />}
                
                {(paymentMethod === 'cash-person' || paymentMethod === 'pay-person') paymentMethod === 'card-person') && (paymentMethod === 'card-person') && ( (
                    <div className="in-person-payment-confirmation">
                        <div className="confirmation-box">
                            {paymentMethod === 'pay-person' ? (
                                <>
                                    <h4>💵 Pay with Cash in Person</h4>
                                    <p>Your booking is confirmed! Please have the exact amount ready (${quote.price} USD) when the driver arrives.</p>
                                </>
                            ) : (
                                <>
                                    <h4>💳 Pay with Card in Person</h4>
                                    <p>Your booking is confirmed! The driver will accept card payments via a card reader when they arrive.</p>
                                </>
                            )}
                            <p className="confirmation-details">
                                <strong>Booking Reference:</strong> SAFERIDE-{Math.floor(Math.random() * 1000000)}</p>
                            <p className="confirmation-details">
                                You will receive a confirmation email with your driver details and tracking information shortly.</p>
                        </div>
                        <button className="book-btn confirmation-btn" onClick={() => onNavigate('home')}>
                            Return to Homepage
                        </button>
                    </div>
                )}
                
                {paymentMethod === 'card-now' && (
                    <p className="subtext">
                        Upon successful payment, you will receive a confirmation email with driver and tracking details.
                    </p>
                )}
            </div>
        </div>
        
    </div>
  );

  return (
    <div className="booking-page-wrapper">
        <h1 className="booking-page-header">Book Your SafeRide Shuttle</h1>
        {step === 1 && renderQuoteCalculator()}
        {step === 2 && renderScheduleRide()}
        {step === 3 && renderPaymentMethodSelection()}
        {step === 4 && renderPaymentProcessing()}
        <button className="back-home-btn" onClick={() => onNavigate('home')}>&larr; Return to Homepage</button>
    </div>
  );
}

export default BookingCalculator;
